{
    "name": "Chameleon Dev Container",
    "image": "chameleon:05301957",
    "workspaceFolder": "/root/Chameleon",
    "workspaceMount": "source=${localWorkspaceFolder},target=/root/Chameleon,type=bind",
    "runArgs": [
        "--gpus",
        "all",
        "--net=host",
        "--privileged",
        "--shm-size=16g",
        "--device=/dev/bus/usb",
        "-v",
        "/tmp/.X11-unix:/tmp/.X11-unix"
    ],
    // 环境变量：等同于 --env="DISPLAY"
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "NVIDIA_VISIBLE_DEVICES": "all",
        "NVIDIA_DRIVER_CAPABILITIES": "all",
        "QT_X11_NO_MITSHM": "1"
    },
    // 进容器后自动执行的命令（可选）
    // 推荐给容器装的 VS Code 插件
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.debugpy",
                "ms-python.vscode-python-envs",
                "ms-python.python",
                "rust-lang.rust-analyzer"
            ]
        }
    }
}